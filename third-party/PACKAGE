load("@prelude//rust:cargo_package.bzl", "set_reindeer_platforms")

# The platforms third-party/reindeer.toml resolves the graph for, and no others:
# a configuration outside them gets no platform-specific attributes.
set_reindeer_platforms(select({
    "DEFAULT": None,
    "prelude//os:linux": select({
        "DEFAULT": None,
        "prelude//cpu:arm64": select({
            "DEFAULT": "linux-arm64",
            "root//platforms:lint": "linux-arm64-lint",
        }),
        "prelude//cpu:x86_64": select({
            "DEFAULT": "linux-x86_64",
            "root//platforms:lint": "linux-x86_64-lint",
        }),
    }),
    "prelude//os:macos": select({
        "DEFAULT": None,
        "prelude//cpu:arm64": "macos-arm64",
    }),
}))
