load("@prelude//rust:cargo_package.bzl", "DEFAULT_REINDEER_PLATFORMS", "set_reindeer_platforms")

# Under root//platforms:lint the third-party graph takes reindeer's -lint
# platforms (third-party/reindeer.toml).
set_reindeer_platforms(select({
    "DEFAULT": DEFAULT_REINDEER_PLATFORMS,
    "root//platforms:lint": select({
        "prelude//cpu:arm64": "linux-arm64-lint",
        "prelude//cpu:x86_64": "linux-x86_64-lint",
    }),
}))
