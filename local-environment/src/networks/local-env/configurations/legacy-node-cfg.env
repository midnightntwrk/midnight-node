# Config keys that node images older than this checkout still require.
#
# `default_cfg()` reads res/cfg/default.toml from disk at runtime (res/src/lib.rs),
# and local-env mounts the working tree over the image's own /res — so a node binary
# older than the checkout looks for keys the current default.toml no longer defines
# and aborts with `Input("configuration error: config error: missing field ...")`.
#
# Unprefixed environment variables are a config source in their own right
# (config::Environment::default, node/src/cfg/mod.rs), so setting a key here fills the
# gap without touching the tracked res/cfg files. A binary that no longer knows a key
# ignores it: build-spec output on the current image is byte-identical with and without
# this file. Add a key here when an older image reports one missing.
#
# tblock_correction_*: required by node-1.0.2 (the only release between node-0.22.1 and
# node-2.1.0 that needs keys HEAD dropped). Values are that release's own defaults.
TBLOCK_CORRECTION_OFFSET=12
TBLOCK_CORRECTION_DISABLE_AFTER=1793404800
