# Environment configuration for local-environment
# Detects system architecture and sets up image tags for midnight-node and indexer

# Enable Docker BuildKit for multi-stage builds
export DOCKER_BUILDKIT=1
export COMPOSE_DOCKER_CLI_BUILD=1

case $(uname -m) in
    x86_64) ARCH="amd64" ;;
    aarch64|arm64) ARCH="arm64" ;;
    *) echo "Unsupported architecture: $(uname -m)"; exit 1 ;;
esac
export ARCHITECTURE=${ARCHITECTURE:-linux/${ARCH}}

GIT_ROOT="$(git rev-parse --show-toplevel)"

# Source .envrc.local early so it can either set inputs (e.g. INDEXER_TAG) that
# feed the defaults below, or override constructed outputs (e.g. INDEXER_API_IMAGE)
# directly — every export uses ${VAR:-default} so user-set values win.
if [ -f .envrc.local ]; then
  # LC_ALL=C: locale collation makes comm reject sort's output as unsorted
  _envrc_before=$(env | LC_ALL=C sort)
  source .envrc.local
  _envrc_changes=$(LC_ALL=C comm -13 <(echo "$_envrc_before") <(env | LC_ALL=C sort) | sed 's/=.*//' | sort -u)
  if [ -n "$_envrc_changes" ]; then
    echo "🔧 .envrc.local set/changed:"
    echo "$_envrc_changes" | sed 's/^/  /'
  fi
  unset _envrc_before _envrc_changes
fi

export MIDNIGHT_RESERVE_CONTRACTS_PATH="${MIDNIGHT_RESERVE_CONTRACTS_PATH:-${GIT_ROOT}/midnight-reserve-contracts}"
NODE_VERSION="$(cat ${GIT_ROOT}/node/Cargo.toml | grep -m 1 version | sed 's/version *= *"\([^\"]*\)".*/\1/')"
GIT_SHORT_TAG="$(git rev-parse HEAD^{tree} | cut -c1-12)"

export MIDNIGHT_NODE_TAG="${MIDNIGHT_NODE_TAG:-${NODE_VERSION}-${GIT_SHORT_TAG}}"
export MIDNIGHT_NODE_IMAGE="${MIDNIGHT_NODE_IMAGE:-ghcr.io/midnight-ntwrk/midnight-node:${MIDNIGHT_NODE_TAG}-${ARCH}}"
export TOOLKIT_IMAGE="${TOOLKIT_IMAGE:-ghcr.io/midnight-ntwrk/midnight-node-toolkit:${MIDNIGHT_NODE_TAG}-${ARCH}}"

INDEXER_EXACT_TAG="$(git -C ${GIT_ROOT}/indexer describe --tags --exact-match HEAD 2>/dev/null | sed 's/^v//')"
if [ -n "${INDEXER_EXACT_TAG}" ]; then
  INDEXER_DEFAULT_TAG="${INDEXER_EXACT_TAG}"
else
  INDEXER_GIT_SHORT_TAG="$(git -C ${GIT_ROOT}/indexer rev-parse --short=8 HEAD)"
  INDEXER_VERSION="$(cat ${GIT_ROOT}/indexer/Cargo.toml | grep -m 1 version | sed 's/version *= *"\([^\"]*\)".*/\1/')"
  INDEXER_DEFAULT_TAG="${INDEXER_VERSION}-${INDEXER_GIT_SHORT_TAG}"
fi

export INDEXER_TAG="${INDEXER_TAG:-${INDEXER_DEFAULT_TAG}}"
export INDEXER_API_IMAGE="${INDEXER_API_IMAGE:-ghcr.io/midnight-ntwrk/indexer-api:${INDEXER_TAG}}"
export INDEXER_WALLET_IMAGE="${INDEXER_WALLET_IMAGE:-ghcr.io/midnight-ntwrk/wallet-indexer:${INDEXER_TAG}}"
export INDEXER_CHAIN_IMAGE="${INDEXER_CHAIN_IMAGE:-ghcr.io/midnight-ntwrk/chain-indexer:${INDEXER_TAG}}"

echo "💻 architecture: ${ARCHITECTURE}"
echo "🦩 midnight-node: ${MIDNIGHT_NODE_IMAGE}"
echo "🧰 toolkit: ${TOOLKIT_IMAGE}"
echo "🌵 indexer: ${INDEXER_CHAIN_IMAGE}"
# Show the contracts commit; keep the path visible only when it's been overridden.
# Require the path's own .git: an uninitialised submodule dir would make git
# fall through to the parent repo and report midnight-node's commit.
if [ -e "${MIDNIGHT_RESERVE_CONTRACTS_PATH}/.git" ]; then
  CONTRACTS_DESC="$(git -C "${MIDNIGHT_RESERVE_CONTRACTS_PATH}" log -1 --format='%h %s')"
else
  CONTRACTS_DESC="not a git checkout"
fi
if [ "${MIDNIGHT_RESERVE_CONTRACTS_PATH}" != "${GIT_ROOT}/midnight-reserve-contracts" ]; then
  CONTRACTS_DESC="${CONTRACTS_DESC} (${MIDNIGHT_RESERVE_CONTRACTS_PATH})"
fi
echo "📜 contracts: ${CONTRACTS_DESC}"
