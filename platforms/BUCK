load("@prelude//platforms:defs.bzl", "host_configuration")
load(":defs.bzl", "re_cache_execution_platform")

# Target platform for the on-chain WASM runtime. Building a target with
# `--target-platforms=root//platforms:wasm32v1-none` makes the rust toolchain
# (toolchains/BUCK) target wasm32v1-none and pass --cfg substrate_runtime.
platform(
    name = "wasm32v1-none",
    constraint_values = [
        "prelude//os/constraints:none",
        "prelude//cpu/constraints:wasm32",
    ],
    visibility = ["PUBLIC"],
)

# CI execution platform: local execution + a remote action CACHE (bazel-remote).
# `.buckconfig`'s prelude platform is the default; `.buckconfig.local` (written by
# buck2/Earthfile +CONFIG) selects this so misses run locally and upload to the
# cache. (The gilescope/rebuck2 distributed `re-exec` platform was retired with
# the mesh workflow - self-hosted runners don't need the fan-out.)
re_cache_execution_platform(
    name = "re-cache",
    cpu_configuration = host_configuration.cpu,
    os_configuration = host_configuration.os,
    visibility = ["PUBLIC"],
)

# Explicit linux-x86_64 target platform for CI. The distributed CI runs on
# x86_64 ubuntu-latest, but buck2's host auto-detection (prelude//platforms:
# default) misfired there — third-party platform selects resolved to arm (neon
# sources on x86 → compile failure). Passing `--target-platforms
# root//platforms:linux-x86_64` pins os:linux + cpu:x86_64 so reindeer's
# `platform = {"linux-x86_64": …}` branches (x86 SIMD, libc, no windows code)
# are selected deterministically, independent of host detection.
platform(
    name = "linux-x86_64",
    constraint_values = [
        "prelude//os/constraints:linux",
        "prelude//cpu/constraints:x86_64",
    ],
    visibility = ["PUBLIC"],
)
