// Cross-contract call into the events contract: one transaction, events from two addresses.
import CompactStandardLibrary;

contract Events {
  circuit log(name: Bytes<32>, payload: Bytes<256>): [];
}

export ledger callee: Events;
export ledger relayed: Counter;

constructor(e: Events) {
  callee = disclose(e);
}

// Emits its own event, then calls the events contract, which emits another.
export circuit relay(name: Bytes<32>, payload: Bytes<256>): [] {
  relayed.increment(1);
  emit(Misc { name: disclose(name), payload: disclose(payload) });
  callee.log(disclose(name), disclose(payload));
}
