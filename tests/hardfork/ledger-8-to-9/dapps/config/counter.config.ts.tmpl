import { CompiledContract, ContractExecutable } from '@midnight-ntwrk/compact-js/effect';
import { Contract as C_ } from './__OUT__/contract/index.js';

type PrivateState = { count: number };
type Ctx = { privateState: PrivateState };

// `any`: compact-js's Witnesses<C> collapses to `never` for generated contracts.
// The private counter shows whether private state survived the fork.
const witnesses = {
  private_increment: ({ privateState }: Ctx) => [{ count: privateState.count + 1 }, []],
} as any;

export default {
  contractExecutable: CompiledContract.make<any>('CounterContract', C_ as any).pipe(
    CompiledContract.withWitnesses(witnesses),
    CompiledContract.withCompiledFileAssets('./__OUT__'),
    ContractExecutable.make
  ),
  createInitialPrivateState: (): PrivateState => ({ count: 0 }),
  config: { keys: { coinPublic: '__COIN_PUBLIC__' }, network: '__NETWORK_ID__' }
}
