import { CompiledContract, ContractExecutable } from '@midnight-ntwrk/compact-js/effect';
import { Contract as C_ } from './__OUT__/contract/index.js';

// The circuit derives the poster key from this secret, so take_down() after the fork
// succeeds only if both the ledger state and the private state survived.
type PrivateState = { secretKey: string };
type Ctx = { privateState: PrivateState };
const SECRET_KEY = 'a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90';

const witnesses = {
  local_secret_key: ({ privateState }: Ctx) =>
    [privateState, Uint8Array.from(Buffer.from(privateState.secretKey, 'hex'))],
} as any;

export default {
  contractExecutable: CompiledContract.make<any>('BboardContract', C_ as any).pipe(
    CompiledContract.withWitnesses(witnesses),
    CompiledContract.withCompiledFileAssets('./__OUT__'),
    ContractExecutable.make
  ),
  createInitialPrivateState: (): PrivateState => ({ secretKey: SECRET_KEY }),
  config: { keys: { coinPublic: '__COIN_PUBLIC__' }, network: '__NETWORK_ID__' }
}
