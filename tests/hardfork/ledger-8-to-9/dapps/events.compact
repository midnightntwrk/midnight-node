// Ledger-9 contract events: a contract-defined event and a standard one.
import CompactStandardLibrary;

export ledger emitted: Counter;

// A contract-defined event: 32-byte name, opaque 256-byte payload.
export circuit log(name: Bytes<32>, payload: Bytes<256>): [] {
  emitted.increment(1);
  emit(Misc { name: disclose(name), payload: disclose(payload) });
}

// A standard event type with an indexed field the indexer can filter on.
export circuit mark(n: Bytes<32>): [] {
  emitted.increment(1);
  emit(ShieldedSpend { nullifier: disclose(n) });
}
