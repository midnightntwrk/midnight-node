// Native keccak256, compiled with --feature-zkir-v3: the proof needs ZKIR v3.
import CompactStandardLibrary;

export ledger last_digest: Bytes<32>;
export ledger hashes: Counter;

// The digest is disclosed, the preimage is not.
export circuit hash(preimage: Bytes<32>): Bytes<32> {
  const digest = disclose(keccak256<Bytes<32>>(preimage));
  last_digest = digest;
  hashes.increment(1);
  return digest;
}
