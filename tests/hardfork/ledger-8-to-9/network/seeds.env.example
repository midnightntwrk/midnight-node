# Copy outside the repository, fill in, chmod 600, and pass as SEEDS_FILE.
#
# Four test wallets, 64 hex characters each; 1-3 need NIGHT and DUST before the baseline.
#   SEED_1  main sender; owns contract A and the dApps
#   SEED_2  second sender; funds contract B and sits on its committee
#   SEED_3  builds the ledger-8 transaction kept for the fork: do not spend from it before the fork
#   SEED_4  receiver; the default ECDSA identity (ECDSA_SEED)
SEED_1=
SEED_2=
SEED_3=
SEED_4=

# The number (1-4) of the seed whose DUST is backed by cNIGHT (scripts/cnight-generates-dust), if any.
CNIGHT_SEED_INDEX=

# SAFE_MODE_DRILL=1: the federated authority's key URIs.
GOV_COUNCIL_URIS=
GOV_TC_URIS=
GOV_EXECUTOR_URI=

# BRIDGE_TEST=1: a live cNIGHT -> NIGHT transfer.
BRIDGE_SIGNING_KEY=
BRIDGE_ICS_CONFIG=
OGMIOS_URL=
BRIDGE_RECIPIENT_HEX=
