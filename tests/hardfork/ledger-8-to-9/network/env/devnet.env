NETWORK_NAME=devnet
NETWORK_ID=devnet
NODE_WS=wss://rpc.devnet.midnight.network
NODE_HTTP=https://rpc.devnet.midnight.network
INDEXER_URL=https://indexer.devnet.midnight.network
FAUCET_URL=https://faucet.devnet.midnight.network
EXPLORER_URL=https://explorer.devnet.midnight.network
EXPLORER_BLOCK_URL='https://polkadot.js.org/apps/?rpc=wss%3A%2F%2Frpc.devnet.midnight.network#/explorer/query/{height}'

# Optional, here or in the environment:
#   EXPECTED_GENESIS_HASH                          fail fast when the network was reset
#   EXTRA_RPC_NODES="name=https://... ..."         more RPC endpoints for the agreement checks
#   KUBE_CONTEXT, KUBE_NAMESPACE, KUBE_POD_REGEX   validator logs and images via kubectl
#   PROOF_SERVER_L8, PROOF_SERVER_L9               proof servers instead of local containers
#   DEPLOYED_NODE_IMAGE, INDEXER_SOURCE_COMMIT     what the network runs, for the security checks
# and any release matrix default of lib/common.sh (L8_REF here also moves the L8 images).
