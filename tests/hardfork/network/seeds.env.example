# The test wallets of one network. Copy this file outside the repository, fill it in,
# chmod 600 it, and pass it as SEEDS_FILE. Each seed is 64 hex characters. Create fresh
# wallets and do not share them with anyone else's tests.

SENDER_SEED=      # sends, deploys the contracts and dApps and is their maintenance authority
RECEIVER_SEED=    # receives; second player; second committee member
HOLDER_SEED=      # builds the old-ledger transaction that is kept unsent: it must not spend before the fork
SPARE_SEED=       # an extra destination
CROSSER_SEED=     # transacts across the fork block; group 2 funds it from the sender

# A funded wallet the `fund` stage sends NIGHT from.
FUNDER_SEED=

# The role (SENDER, RECEIVER, HOLDER or SPARE) of the wallet whose DUST is backed by cNIGHT, if any.
CNIGHT_WALLET=

# For SAFE_MODE_DRILL=1: the key URIs of the federated authority.
GOV_COUNCIL_URIS=
GOV_TC_URIS=
GOV_EXECUTOR_URI=

# For BRIDGE_TEST=1: a live cNIGHT -> NIGHT transfer to the spare wallet.
BRIDGE_SIGNING_KEY=
BRIDGE_ICS_CONFIG=
OGMIOS_URL=
BRIDGE_RECIPIENT_HEX=
