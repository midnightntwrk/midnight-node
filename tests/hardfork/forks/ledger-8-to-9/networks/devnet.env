# Reachable only over the VPN.
NETWORK_NAME=devnet
NETWORK_ID=devnet
NODE_WS=wss://rpc.devnet.shielded.tools
NODE_HTTP=https://rpc.devnet.shielded.tools
INDEXER_URL=https://indexer.devnet.shielded.tools
FAUCET_URL=https://faucet.devnet.shielded.tools
EXPLORER_URL=https://explorer.devnet.shielded.tools
EXPLORER_BLOCK_URL='https://polkadot.js.org/apps/?rpc=wss%3A%2F%2Frpc.devnet.shielded.tools#/explorer/query/{height}'

# Optional, here or in the environment:
#   EXPECTED_GENESIS_HASH                          fail fast when the network was reset
#   EXTRA_RPC_NODES="name=https://... ..."         more RPC endpoints for the agreement checks
#   KUBE_CONTEXT, KUBE_NAMESPACE, KUBE_POD_REGEX   validator logs and images via kubectl
#   PROOF_SERVER_OLD, PROOF_SERVER_NEW             proof servers instead of local containers
#   DEPLOYED_NODE_IMAGE, INDEXER_SOURCE_COMMIT     what the network runs, for the security checks
# and any default of ../../matrix.sh (OLD_REF here also moves the old images).
