import { CompiledContract, ContractExecutable } from '@midnight-ntwrk/compact-js/effect';
import { Contract as C_ } from './__OUT__/contract/index.js';

// One private state file per player and game; the suite writes it before the player's
// first call.
type PrivateState = { secretKey: string; move: number; salt: string };
type Ctx = { privateState: PrivateState };
const bytes = (hex: string) => Uint8Array.from(Buffer.from(hex, 'hex'));

const witnesses = {
  secret_key: ({ privateState }: Ctx) => [privateState, bytes(privateState.secretKey)],
  my_move: ({ privateState }: Ctx) => [privateState, BigInt(privateState.move)],
  salt: ({ privateState }: Ctx) => [privateState, bytes(privateState.salt)],
} as any;

export default {
  contractExecutable: CompiledContract.make<any>('RpsContract', C_ as any).pipe(
    CompiledContract.withWitnesses(witnesses),
    CompiledContract.withCompiledFileAssets('./__OUT__'),
    ContractExecutable.make
  ),
  createInitialPrivateState: (): PrivateState => ({ secretKey: '00'.repeat(32), move: 0, salt: '00'.repeat(32) }),
  config: { keys: { coinPublic: '__COIN_PUBLIC__' }, network: '__NETWORK_ID__' }
}
