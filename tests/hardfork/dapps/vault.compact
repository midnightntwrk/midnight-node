// Mints an unshielded token into its own balance and pays it out. A test contract: anyone
// may call either circuit.

pragma language_version >= 0.16.0;

import CompactStandardLibrary;

export ledger token: Bytes<32>;
export ledger minted: Uint<128>;
export ledger paid: Uint<128>;

export circuit mint(amount: Uint<64>): [] {
    token = mintUnshieldedToken(pad(32, "hf:vault"), disclose(amount), left<ContractAddress, UserAddress>(kernel.self()));
    minted = (minted + disclose(amount)) as Uint<128>;
}

export circuit pay_out(to: Bytes<32>, amount: Uint<128>): [] {
    sendUnshielded(token, disclose(amount), right<ContractAddress, UserAddress>(UserAddress { bytes: disclose(to) }));
    paid = (paid + disclose(amount)) as Uint<128>;
}
