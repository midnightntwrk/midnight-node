pragma language_version >= 0.22.0;
import CompactStandardLibrary;

export ledger color: Bytes<32>;
constructor(token: Bytes<32>) { color = disclose(token); }

export circuit deposit(amount: Uint<128>): [] {
  assert(disclose(amount) > 0, "zero amount");
  receiveUnshielded(color, disclose(amount));
}

export circuit balance(): Uint<128> { return unshieldedBalance(color); }

export circuit withdraw(amount: Uint<128>, recipient: Bytes<32>): [] {
  assert(disclose(amount) > 0, "zero amount");
  sendUnshielded(color, disclose(amount),
    right<ContractAddress, UserAddress>(UserAddress { bytes: disclose(recipient) }));
}
